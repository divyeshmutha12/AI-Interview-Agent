# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OpenAI Embeddings Configuration (for Knowledge Base)
EMBEDDING_MODEL=text-embedding-3-small

# Langfuse Configuration (Observability & Tracing)
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Prompt Label Strategy
# Options:
#   - Developer names: divyesh, teammate1, teammate2
#   - Environments: production, staging, development
#   - Status: review, approved, testing
LANGFUSE_PROMPT_LABEL=divyesh

# Tavily Web Search Configuration
# Get your free API key from: https://tavily.com (1000 searches/month free)
TAVILY_API_KEY=your_tavily_api_key_here
